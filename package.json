{
  "name": "logosquest",
  "private": true,
  "version": "0.1.0",
  "description": "LogosQuest: A Jornada dos Originais — Hebraico Bíblico e Grego Koiné do zero à leitura",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-content": "tsx scripts/validate-content.ts",
    "build-texts": "tsx scripts/build-texts.ts",
    "generate-audio": "tsx scripts/generate-audio.ts",
    "fetch-media": "tsx scripts/fetch-media.ts",
    "build-attributions": "tsx scripts/build-attributions.ts",
    "make-fixture": "tsx scripts/make-fixture.ts",
    "e2e": "node scripts/e2e-smoke.mjs",
    "check": "npm run typecheck && npm run validate-content && npm run test"
  },
  "dependencies": {
    "@fontsource/gentium-plus": "^5.2.0",
    "@fontsource/noto-serif-hebrew": "^5.2.0",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "ts-fsrs": "^5.2.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
