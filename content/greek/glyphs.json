  {"kind": "mark", "id": "gr:mark:smooth", "char": "̓", "display": "ἀ", "name": "Espírito suave", "translit": "", "speak": "α", "sound": {"gr-koine": "Não muda o som. Toda palavra que começa com vogal leva um espírito; este, em forma de vírgula, indica que não há h.", "gr-erasmian": "Não muda o som: indica ausência de h."}, "confusables": ["gr:mark:rough", "gr:mark:acute"]},
