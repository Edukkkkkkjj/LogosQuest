  {"kind": "mark", "id": "gr:mark:acute", "char": "́", "display": "ά", "name": "Acento agudo", "translit": "", "speak": "ά", "sound": {"gr-koine": "Marca a sílaba tônica.", "gr-erasmian": "Marca a sílaba tônica."}, "confusables": ["gr:mark:grave", "gr:mark:smooth"]},
  {"kind": "mark", "id": "gr:mark:grave", "char": "̀", "display": "ὰ", "name": "Acento grave", "translit": "", "speak": "ά", "sound": {"gr-koine": "Também marca a tônica. É o agudo da última sílaba quando outra palavra vem logo depois.", "gr-erasmian": "Também marca a tônica."}, "confusables": ["gr:mark:acute", "gr:mark:rough"]},
  {"kind": "mark", "id": "gr:mark:circumflex", "char": "͂", "display": "ᾶ", "name": "Acento circunflexo", "translit": "", "speak": "ά", "sound": {"gr-koine": "Marca a tônica; só aparece sobre vogais longas ou ditongos.", "gr-erasmian": "Marca a tônica sobre vogal longa."}, "confusables": ["gr:mark:acute", "gr:mark:diaeresis"]},
  {"kind": "mark", "id": "gr:mark:iota-subscript", "char": "ͅ", "display": "ᾳ", "name": "Iota subscrito", "translit": "", "speak": "α", "sound": {"gr-koine": "Um iota pequeno sob α, η ou ω. Não se pronuncia, mas é pista gramatical valiosa: muitas vezes indica dativo (ἀρχῇ).", "gr-erasmian": "Não se pronuncia; muitas vezes indica dativo."}, "confusables": ["gr:mark:circumflex", "gr:mark:smooth"]},
