  "he:lex:b": { "glosses": ["em", "com", "por meio de"], "usageNote": "Preposição inseparável: nunca aparece sozinha, vem colada no início da palavra seguinte." },
  "he:lex:c": { "glosses": ["e", "mas", "então"], "usageNote": "Conjunção colada à palavra seguinte. A vogal muda conforme a vizinhança (וְ, וּ, וַ, וָ)." },
